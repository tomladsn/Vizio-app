{
  "name": "vizio",
  "version": "0.1.0",
  "author": "Tomladsn",
  "description": "AI-powered media agent desktop app for advanced video processing.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,yellow \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:web": "vite",
    "build": "vite build && electron-builder",
    "build:web": "vite build",
    "preview": "vite preview",
    "test-bins": "node scripts/test-bins.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "groq-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vite": "^8.1.5",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.vizio.app",
    "productName": "Vizio",
    "copyright": "Copyright (c) 2024 Vizio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/bin/win32",
          "to": "bin",
          "filter": [
            "**"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "extraResources": [
        {
          "from": "resources/bin/darwin",
          "to": "bin",
          "filter": [
            "**"
          ]
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "resources/bin/linux",
          "to": "bin",
          "filter": [
            "**"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
