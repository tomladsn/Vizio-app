{
  "name": "visio-media-agent",
  "version": "0.1.0",
  "author": "Visio Team",
  "description": "AI-powered media agent desktop app for advanced video processing.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,yellow \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:web": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "codemap": "node codemap.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "groq-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.visio.media-agent",
    "productName": "Visio Media Agent",
    "copyright": "Copyright © 2024 Visio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "icon.png"
    ],
    "icon": "icon.png",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
